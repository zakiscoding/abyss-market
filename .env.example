# Copy to .env locally. Never commit real keys.
# Fake mode needs no key and is the default demo.
ABYSS_FAKE_LLM=1
ABYSS_REAL_MODELS=0
ABYSS_PRICE_WEIGHT=1.0
ABYSS_FAKE_DELAY=0.3

# Used only when ABYSS_FAKE_LLM is unset and you want live model calls.
ANTHROPIC_API_KEY=

# Optional overrides. Defaults are runs/ledger.jsonl and runs/reputation.json.
# ABYSS_LEDGER_PATH=
# ABYSS_REP_PATH=

# Frontend WebSocket. Leave unset in Docker so the browser uses the nginx /ws proxy.
# VITE_WS_URL=ws://localhost:8000/ws
